{
  "manifest_version": 3,
  "version": "1.0.0",
  "name": "Job Tracker Extension",
  "description": "Track job applications, extract job details, and manage your job search workflow",

  "permissions": [
    "activeTab",
    "sidePanel",
    "storage",
    "scripting",
    "clipboardWrite"
  ],

  "host_permissions": [
    "http://localhost:5000/*",
    "https://*/*",
    "http://*/*"
  ],

  "action": {
    "default_title": "Open Job Tracker"
  },

  "side_panel": {
    "default_path": "sidepanel.html"
  },

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],

  "icons": {
    "16": "public/icons.svg",
    "48": "public/icons.svg",
    "128": "public/icons.svg"
  }
}